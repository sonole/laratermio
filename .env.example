APP_NAME="laratermio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laratermio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sent only over HTTPS. Defaults to on when APP_URL starts with https://.
# SESSION_SECURE_COOKIE=true

# Cloudflare's IP ranges are trusted by default (monicahq/laravel-cloudflare): fetched from cloudflare.com,
# cached, and refreshed weekly by the scheduler (or `php artisan cloudflare:reload`). Loopback and the
# server's own address are always trusted too. Set this to false only to switch the Cloudflare part off.
# See "Deploying behind Cloudflare" in the README.
# LARAVEL_CLOUDFLARE_ENABLED=true

# Contact form limits per visitor IP per hour and for everyone per day (0 switches one off).
CONTACT_MAX_PER_IP_PER_HOUR=3
CONTACT_MAX_PER_DAY=50

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Laratermio"
RESEND_API_KEY=

ADMIN_EMAIL="foobar@example.com"
ADMIN_NAME="Foo Bar"

VITE_APP_NAME="${APP_NAME}"
